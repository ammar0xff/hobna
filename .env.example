# ─── App ───
NODE_ENV=production
NEXTAUTH_SECRET=change-me-to-random
NEXTAUTH_URL=http://localhost:3000
DATA_DIR=/app/data

# ─── Google Drive ───
# Optional: set these to enable Google Drive storage
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── Database ───
# SQLite is used by default (stored in DATA_DIR)
